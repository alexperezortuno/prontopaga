{
  "name": "financial-risk-mvp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @financial-risk/api --filter @financial-risk/web dev",
