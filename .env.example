# Backend
PORT=3000
JWT_SECRET=replace-with-a-local-development-secret
JWT_EXPIRES_IN=1h

# Frontend local development
VITE_API_URL=http://localhost:3000

# Docker Compose host ports
API_PORT=3000
WEB_PORT=5173

# Docker development only; Vite proxies /api to this Compose service.
VITE_DEV_API_TARGET=http://api:3000
