FROM node:22.23.2-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
ENV CI=true

RUN corepack enable && corepack prepare pnpm@11.8.0 --activate \
    && mkdir -p /pnpm/store

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json

RUN --mount=type=cache,id=prontopaga-pnpm,target=/pnpm/store,uid=1000,gid=1000 \
    pnpm install --frozen-lockfile

COPY apps/api apps/api
COPY apps/web apps/web
RUN pnpm --filter @financial-risk/api build \
    && pnpm deploy --legacy --filter @financial-risk/api --prod /runtime

FROM node:22.23.2-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=qa
ENV PORT=3000

COPY --from=build /runtime/package.json ./package.json
COPY --from=build /runtime/node_modules ./node_modules
COPY --from=build /runtime/dist ./dist

USER node
EXPOSE 3000

CMD ["node", "dist/main.js"]
